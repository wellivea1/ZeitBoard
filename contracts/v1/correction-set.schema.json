{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Append-only correction set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "corrections"],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "generated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "corrections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/correction"
      }
    }
  },
  "$defs": {
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correction_id", "target_observation_id", "created_at", "reason", "changes"],
      "allOf": [
        {
          "if": {
            "required": ["acquisition_method"],
            "properties": {
              "acquisition_method": {
                "const": "health_connect"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": ["source_conflict", "source_deleted", "source_restored"]
              },
              "changes": {
                "not": {
                  "required": ["sleep_classification"]
                }
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": ["based_on_source_revision"]
                },
                {
                  "required": ["supersedes_correction_ids"]
                }
              ]
            }
          },
          "else": {
            "properties": {
              "reason": {
                "enum": ["user_edit", "duplicate", "invalid_range", "source_conflict"]
              }
            }
          }
        },
        {
          "if": {
            "required": ["reason"],
            "properties": {
              "reason": {
                "const": "source_conflict"
              }
            }
          },
          "then": {
            "if": {
              "required": ["acquisition_method"],
              "properties": {
                "acquisition_method": {
                  "const": "health_connect"
                }
              }
            },
            "then": {
              "properties": {
                "changes": {
                  "not": {
                    "required": ["excluded"]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["reason"],
            "properties": {
              "reason": {
                "const": "source_deleted"
              }
            }
          },
          "then": {
            "properties": {
              "changes": {
                "required": ["excluded"],
                "maxProperties": 1,
                "properties": {
                  "excluded": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["reason"],
            "properties": {
              "reason": {
                "const": "source_restored"
              }
            }
          },
          "then": {
            "properties": {
              "changes": {
                "required": ["excluded"],
                "maxProperties": 1,
                "properties": {
                  "excluded": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "correction_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "target_observation_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "created_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "reason": {
          "type": "string",
          "enum": ["user_edit", "duplicate", "invalid_range", "source_conflict", "source_deleted", "source_restored"],
          "description": "source_deleted and source_restored are a provider saying its record is gone, or back. They leave the record out or count it again and change nothing else, and only a provider gives them."
        },
        "acquisition_method": {
          "type": "string",
          "enum": ["manual", "health_connect"],
          "description": "Correction author; omitted means manual. Health Connect provider revisions explicitly identify their source."
        },
        "changes": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "start_at": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "end_at": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "sleep_classification": {
              "type": "string",
              "enum": ["principal", "nap", "unknown"]
            },
            "excluded": {
              "type": "boolean"
            }
          }
        },
        "supersedes_correction_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/identifier"
          }
        },
        "based_on_source_revision": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    }
  }
}
