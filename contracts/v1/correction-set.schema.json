{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Append-only correction set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "corrections"],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "generated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "corrections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/correction"
      }
    }
  },
  "$defs": {
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correction_id", "target_observation_id", "created_at", "reason", "changes"],
      "allOf": [
        {
          "if": {
            "required": ["acquisition_method"],
            "properties": {
              "acquisition_method": {
                "const": "health_connect"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": "source_conflict"
              },
              "changes": {
                "not": {
                  "anyOf": [
                    {
                      "required": ["excluded"]
                    },
                    {
                      "required": ["sleep_classification"]
                    }
                  ]
                }
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": ["based_on_source_revision"]
                },
                {
                  "required": ["supersedes_correction_ids"]
                }
              ]
            }
          }
        }
      ],
      "properties": {
        "correction_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "target_observation_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "created_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "reason": {
          "type": "string",
          "enum": ["user_edit", "duplicate", "invalid_range", "source_conflict"]
        },
        "acquisition_method": {
          "type": "string",
          "enum": ["manual", "health_connect"],
          "description": "Correction author; omitted means manual. Health Connect provider revisions explicitly identify their source."
        },
        "changes": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "start_at": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "end_at": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "sleep_classification": {
              "type": "string",
              "enum": ["principal", "nap", "unknown"]
            },
            "excluded": {
              "type": "boolean"
            }
          }
        },
        "supersedes_correction_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/identifier"
          }
        },
        "based_on_source_revision": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    }
  }
}
