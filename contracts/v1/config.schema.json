{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Application configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "app", "storage", "collectors", "estimation", "sharing"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time_zone", "fixture_mode", "log_level"],
      "properties": {
        "time_zone": {"$ref": "common.schema.json#/$defs/zoneId"},
        "fixture_mode": {"type": "boolean", "default": true},
        "log_level": {"type": "string", "enum": ["error", "warn", "info", "debug"]}
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database_path"],
      "properties": {
        "database_path": {"type": "string", "minLength": 1}
      }
    },
    "collectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windows_activity", "health_connect"],
      "properties": {
        "windows_activity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "sample_interval_seconds"],
          "properties": {
            "enabled": {"type": "boolean", "default": false},
            "sample_interval_seconds": {"type": "integer", "minimum": 15, "maximum": 3600}
          }
        },
        "health_connect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean", "default": false}
          }
        }
      }
    },
    "estimation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_principal_sleep_episodes", "forecast_cycles"],
      "properties": {
        "minimum_principal_sleep_episodes": {"type": "integer", "minimum": 3, "maximum": 60},
        "forecast_cycles": {"type": "integer", "minimum": 1, "maximum": 14}
      }
    },
    "sharing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "default_profile_ttl_hours"],
      "properties": {
        "enabled": {"type": "boolean", "const": false, "default": false},
        "default_profile_ttl_hours": {"type": "integer", "minimum": 1, "maximum": 168}
      }
    }
  }
}
