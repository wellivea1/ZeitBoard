{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sync batch v1",
  "oneOf": [
    {
      "$ref": "#/$defs/pushBatch"
    },
    {
      "$ref": "#/$defs/pullBatch"
    }
  ],
  "$defs": {
    "pushBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "records"],
      "properties": {
        "schema_version": {
          "$ref": "common.schema.json#/$defs/schemaVersion"
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/pushRecord"
          }
        }
      }
    },
    "pullBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "cursor", "records"],
      "properties": {
        "schema_version": {
          "$ref": "common.schema.json#/$defs/schemaVersion"
        },
        "cursor": {
          "type": "integer",
          "minimum": 0
        },
        "records": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/envelope"
          }
        }
      }
    },
    "pushRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordId", "kind", "createdAt", "payload"],
      "properties": {
        "recordId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "kind": {
          "type": "string",
          "enum": ["observation", "correction", "task"]
        },
        "createdAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "payload": {
          "$ref": "#/$defs/payload"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/kindPayloadMatch"
        }
      ]
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "recordId", "kind", "deviceId", "createdAt", "payload"],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "recordId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "kind": {
          "type": "string",
          "enum": ["observation", "correction", "task", "tombstone"]
        },
        "deviceId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "createdAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "payload": {
          "$ref": "#/$defs/payload"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/kindPayloadMatch"
        }
      ]
    },
    "payload": {
      "oneOf": [
        {
          "$ref": "observation-set.schema.json#/$defs/observation"
        },
        {
          "$ref": "correction-set.schema.json#/$defs/correction"
        },
        {
          "$ref": "#/$defs/taskPayload"
        },
        {
          "$ref": "#/$defs/tombstonePayload"
        }
      ]
    },
    "taskPayload": {
      "allOf": [
        {
          "$ref": "task-set.schema.json#/$defs/task"
        },
        {
          "required": ["revision", "updated_at"]
        }
      ]
    },
    "tombstonePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id"],
      "properties": {
        "record_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        }
      }
    },
    "kindPayloadMatch": {
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "observation"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "observation-set.schema.json#/$defs/observation"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "correction"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "correction-set.schema.json#/$defs/correction"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "task"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/taskPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tombstone"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/tombstonePayload"
              }
            }
          }
        }
      ]
    }
  }
}
