{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Server estimation accuracy projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "status": {
      "type": "string",
      "enum": ["estimated", "refused"]
    },
    "refusal": {"$ref": "#/$defs/refusal"},
    "report": {"$ref": "#/$defs/report"}
  },
  "oneOf": [
    {
      "properties": {"status": {"const": "estimated"}},
      "required": ["report"],
      "not": {"required": ["refusal"]}
    },
    {
      "properties": {"status": {"const": "refused"}},
      "required": ["refusal"],
      "not": {"required": ["report"]}
    }
  ],
  "$defs": {
    "refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": ["insufficient_data", "ambiguous_cycle_index", "conflicting_observations", "unsupported_input"]
        },
        "message": {"type": "string", "minLength": 1, "maxLength": 240}
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluations",
        "refusals",
        "medianAbsErrorHours",
        "meanAbsErrorHours",
        "p90AbsErrorHours",
        "hitRate",
        "calibration"
      ],
      "properties": {
        "evaluations": {"type": "integer", "minimum": 0},
        "refusals": {"type": "integer", "minimum": 0},
        "medianAbsErrorHours": {"type": "number", "minimum": 0},
        "meanAbsErrorHours": {"type": "number", "minimum": 0},
        "p90AbsErrorHours": {"type": "number", "minimum": 0},
        "hitRate": {"type": "number", "minimum": 0, "maximum": 1},
        "calibration": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["level", "count", "hitRate", "medianAbsErrorHours"],
            "properties": {
              "level": {"type": "string", "enum": ["low", "medium", "high"]},
              "count": {"type": "integer", "minimum": 1},
              "hitRate": {"type": "number", "minimum": 0, "maximum": 1},
              "medianAbsErrorHours": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    }
  }
}
