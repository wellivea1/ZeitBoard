{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "tasks"],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "generated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "title", "duration_minutes", "status", "created_at"],
      "properties": {
        "task_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "duration_minutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 720
        },
        "status": {
          "type": "string",
          "enum": ["open", "done"]
        },
        "created_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "earliest_start_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "latest_finish_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "preferred_after_wake_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1440
        },
        "minimum_confidence": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "updated_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    }
  }
}
