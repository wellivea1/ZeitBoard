{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "non24-planner",
  "outputfilename": "Non24Planner",
  "frontend:install": "npm --prefix ../../.. ci",
  "frontend:build": "npm --prefix ../../.. run build --workspace @non24/desktop-frontend",
  "frontend:dev:watcher": "npm --prefix frontend run dev -- --host 127.0.0.1",
  "frontend:dev:serverUrl": "auto",
