# Enforce consistent line endings across platforms. Text files are stored and
# checked out with LF everywhere, so gofmt and other tools behave identically on
# Linux and Windows CI runners.
* text=auto eol=lf

# Windows batch scripts require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must never be line-ending converted.
*.png binary
*.ico binary
*.jar binary
*.jks binary
*.keystore binary
*.docx binary
*.exe binary
